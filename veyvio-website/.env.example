# Veyvio public website — environment variables
# Copy to .env.local (dev) or set in CI before `npm run build` (production client vars)

# --- Client (VITE_*) — inlined at build time ---
VITE_LEGAL_COMPANY_NAME=Veyvio Ltd
VITE_SITE_URL=https://veyvio.co.uk
VITE_SALES_EMAIL=info@veyvio.co.uk
VITE_SUPPORT_EMAIL=support@veyvio.co.uk
VITE_SIGN_IN_URL=https://veyvio-admin.pages.dev/login
VITE_DATA_HOSTING_REGION=United Kingdom / European Union
VITE_CALENDAR_BOOKING_URL=https://cal.com/your-team/veyvio-demo

# Analytics (optional — only fires after cookie consent)
# VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint/events

VITE_CRM_PROVIDER=hubspot
VITE_EMAIL_PROVIDER=resend
VITE_CONSENT_PROVIDER=cookiebot

# --- Worker secrets (wrangler secret put — NOT in client bundle) ---
# CRM_PROVIDER=hubspot
# HUBSPOT_ACCESS_TOKEN=pat-...
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# DEMO_FROM_EMAIL=Veyvio <hello@veyvio.com>
# DEMO_NOTIFY_EMAIL=hello@veyvio.com
# CALENDAR_BOOKING_URL=https://cal.com/your-team/veyvio-demo

# --- Local dev only (Vite middleware reads these) ---
# Same secret names without VITE_ prefix work in npm run dev
