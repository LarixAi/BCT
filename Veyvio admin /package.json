    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:tenant-isolation": "node scripts/tenant-isolation-smoke.mjs",
    "test:dispatch-gates-live": "node scripts/dispatch-gates-live-smoke.mjs",
    "test:application-scopes": "node scripts/application-scopes.unit.mjs",
    "test:defect-damage-link": "node scripts/defect-damage-link.unit.mjs",
    "test:yard-live": "node scripts/yard-live-smoke.mjs",
    "test:gate2-unit": "node scripts/gate2-shared.unit.mjs",
    "test:gate2-live": "node scripts/gate2-live-smoke.mjs",
    "gate1:bct-readiness": "node scripts/gate1-bct-readiness.mjs",
    "gate1:bct-pilot-setup": "node scripts/gate1-bct-pilot-setup.mjs",
    "gate1:rotate-credentials": "node scripts/rotate-gate1-credentials.mjs",
    "backend:login": "supabase login",
    "backend:whoami": "supabase projects list",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset",
    "backend:link": "supabase link --project-ref qeckgqjrfbdyxchuncdt",
    "backend:deploy": "supabase db push && supabase functions deploy command-api --no-verify-jwt"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@veyvio/entitlements": "file:../packages/entitlements",
