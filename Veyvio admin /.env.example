# Live Command API via same-origin Pages Functions BFF (Wave 3E-1).
# Mock is opt-in for Playwright/unit tests only.
# VITE_MOCK_API=true

# Never enable hybrid operations mock — removed for tenant isolation.
# VITE_OPERATIONS_MOCK must not be set to true in any deployed environment.

# Production / pages deploy: same-origin BFF (required).
VITE_API_URL=/api/command

# Optional: still useful for tooling; SPA no longer refreshes tokens in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
