{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:phone": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest run && node scripts/assert-release-config.unit.mjs",
    "test:watch": "vitest",
    "test:f03-gate0": "node scripts/f03-gate0-scanner.mjs",
    "test:demo-persist": "node --experimental-strip-types veyvio-website/scripts/demo-persist.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:production-build": "node scripts/verify-production-build.mjs",
    "assert:release-config": "node scripts/assert-release-config.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "gate1:ios-simulator-probe": "npm run gate1:ios-simulator-probe --prefix veyvio-driver-App",
    "test:audit-secrets": "node scripts/audit-secrets.unit.mjs",
    "gate1:preflight": "node scripts/gate1-preflight.mjs",
    "gate1:bct-readiness": "npm run gate1:bct-readiness --prefix \"Veyvio admin \"",
    "gate1:bct-pilot-setup": "npm run gate1:bct-pilot-setup --prefix \"Veyvio admin \"",
    "gate1:rotate-credentials": "npm run gate1:rotate-credentials --prefix \"Veyvio admin \"",
    "gate1:device-exit": "node veyvio-driver-App/scripts/gate1-device-exit.mjs",
    "gate1:device-handset": "node veyvio-driver-App/scripts/gate1-device-handset.mjs",
    "gate1:operator-status": "node scripts/gate1-operator-status.mjs",
    "gate1:ios-checklist": "node scripts/gate1-operator-status.mjs --ios-sheet",
    "build:mobile": "VITE_MOBILE_BUILD=true vite build --mode mobile",
    "deploy:yard": "npm run build && node scripts/assert-yard-deploy.mjs && npx wrangler deploy --config .output/server/wrangler.json",
    "deploy:website": "npm run deploy --prefix veyvio-website",
    "setup:domains": "node scripts/setup-veyvio-domains.mjs",
    "setup:email": "node scripts/switch-veyvio-email-destination.mjs",
    "setup:integrations": "node scripts/setup-veyvio-integrations.mjs",
    "setup:resend-dns": "node scripts/setup-resend-dns.mjs",
    "test:website:a11y": "npm run test:a11y --prefix veyvio-website",
    "icons:android": "node scripts/generate-brand-icons.mjs",
    "cap:sync": "npm run build:mobile && npm run icons:android && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:debug": "bash scripts/build-android-debug.sh",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:launch": "adb shell monkey -p uk.veyvio.yard -c android.intent.category.LAUNCHER 1",
    "android:run": "npm run android:debug && npm run android:install && npm run android:launch"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.6.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
