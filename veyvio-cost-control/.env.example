# Veyvio Cost Control — local environment
# Vite loads env from the monorepo root (vite.config envDir) and this folder.

# Auth: Command API (required for live sign-in)
VITE_API_URL=https://qeckgqjrfbdyxchuncdt.supabase.co/functions/v1/command-api
VITE_SUPABASE_ANON_KEY=
# VITE_AUTH_MODE=demo   # force in-memory demo auth only

# Finance workspace data
# demo = seed store (org_demo_cec only)
# api  = GET {VITE_FINANCE_API_URL}/finance/workspace
VITE_FINANCE_DATA_MODE=api
VITE_FINANCE_API_URL=https://qeckgqjrfbdyxchuncdt.supabase.co/functions/v1/finance-api

# Open Banking (read-only AIS) — see docs/deploy/cost-control-bank-open-banking.md
# demo_live | open_banking | disconnected
VITE_BANK_FEED_MODE=open_banking
# truelayer_sandbox | truelayer | yapily_sandbox | yapily | generic_ais
VITE_BANK_PROVIDER=truelayer_sandbox
VITE_BANK_CLIENT_ID=
# Same Edge Function hosts the bank token proxy routes
VITE_BANK_TOKEN_PROXY_URL=https://qeckgqjrfbdyxchuncdt.supabase.co/functions/v1/finance-api
VITE_BANK_REDIRECT_URI=http://localhost:5176/settings?bank_callback=1
# Server secrets (finance-api Edge Function — never put in Vite):
# BANK_CLIENT_SECRET, BANK_CLIENT_ID, BANK_PROVIDER, BANK_REDIRECT_URI or BANK_REDIRECT_URI_ALLOWLIST
# Consent start requires a signed-in finance membership JWT; missing BANK_CLIENT_SECRET fails closed.

# Sage (optional) — Connect stays disabled until product + proxy are set
# VITE_SAGE_MODE=disconnected
# VITE_SAGE_PRODUCT=undecided
# VITE_SAGE_TOKEN_PROXY_URL=
# VITE_SAGE_CLIENT_ID=
# VITE_SAGE_REDIRECT_URI=http://localhost:5176/settings?sage_callback=1
