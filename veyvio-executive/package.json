{
  "name": "@veyvio/executive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/assert-production-build.mjs && node scripts/scan-production-secrets.mjs --build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run security:scan:source && npm run build && node --test tests/*.test.mjs",
    "test:login:e2e": "node scripts/login-flow.e2e.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern sbom",
    "security:scan": "node scripts/scan-production-secrets.mjs --source --build",
    "security:scan:source": "node scripts/scan-production-secrets.mjs --source",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "security:rotate:dry-run": "node scripts/rotate-session-secret-checklist.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
