# Server-only Veyvio identity connection.
# Local development values live in gitignored `.env.local` / `.dev.vars`.
# Production values must be configured in ChatGPT Sites / Worker secret storage.
# Never put SUPABASE_SERVICE_ROLE_KEY or sb_secret_* on the Executive Worker.

VEYVIO_EXECUTIVE_ENV=development
VEYVIO_COMMAND_API_URL=
VEYVIO_SUPABASE_URL=

# Prefer publishable keys when available; legacy anon JWT remains accepted.
VEYVIO_COMMAND_PUBLISHABLE_KEY=
VEYVIO_COMMAND_ANON_KEY=

# HMAC secret for Executive session binding cookies. Minimum 32 characters.
VEYVIO_EXECUTIVE_SESSION_SECRET=

# Local UI preview only. Must be 0 for production/CI builds.
VEYVIO_EXECUTIVE_LOCAL_DEMO=0
